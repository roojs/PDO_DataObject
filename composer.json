{
    "name": "roojs/pdo_dataobject",
    "type": "library",
    "description": "ORM based on PEAR::DB_DataObject ported for PHP 8.4+ and PDO",
    "keywords": [
        "orm"
    ],
    "homepage": "https://github.com/roojs/PDO_DataObject#v0.1.0",
    "license": "LGPL-3.0",
    "authors": [
        {
            "name": "Alan Knowles",
            "email": "alan@roojs.com"
        }
    ],
    "autoload": {
        "psr-0": {
            "PDO": "./"
        }
    },
    "require": {
        "php": ">=8.4"
    },
    "archive": {
        "exclude": [
            "/scripts",
            "/tests",
            "/docs",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/.cursorindexingignore",
            "/package2.xml"
        ]
    },
    "config": {
        "secure-http": false
    }
}
